# Copy these settings into your ignored .env.local.
# Public browser token only (pk.); never use a Mapbox secret token (sk.).
MAPBOX_PUBLIC_TOKEN=
# ShiftCare credentials stay on the server.
SHIFTCARE_API_REGION=au
SHIFTCARE_ACCOUNT_ID=
SHIFTCARE_API_KEY=
# Use the time zone configured in your ShiftCare account.
SHIFTCARE_TIME_ZONE=Australia/Perth
# Enable only the operations whose field mapping and account trial have passed.
# Supported: client.upsert,staff.create,staff.update,shift.cancel,shift.assign,
# document.file,document.metadata,qualification.expiry,communication.handoff
OCD_SHIFTCARE_WRITE_OPERATIONS=
# Exact approved hostnames used by ShiftCare's pre-signed document downloads.
# Needed for independently hashing filed documents; links are never cached or shared.
SHIFTCARE_DOCUMENT_HOSTS=
# Optional extended source-to-native profile mappings. Only supported fields are accepted.
# Example: {"version":"v1","approvedBy":"Office approver","client":{"address":"address","ndisNumber":"ndis_number"},"staff":{}}
OCD_NATIVE_FIELD_MAPPINGS=
# Explicit staff scope for scheduled compliance collection (up to 20 IDs per batch).
OCD_COMPLIANCE_STAFF_IDS=
OCD_DOCUMENT_NOTICE_DAYS=30
OCD_ETA_FRESH_SECONDS=90
# Client cancellation rules remain subject to exact office review.
OCD_CANCELLATION_POLICY=
# Shared PostgreSQL persistence for intake and native workflow cases.
# Run npm run db:migrate before selecting PostgreSQL. Existing files/Redis are not migrated automatically.
DATABASE_URL=
# Our own worker runs with npm run automation:worker. No automation platform is needed.
AUTOMATION_POLL_MS=30000
# npm start runs our worker locally. For a persistent production host, enable this
# or run automation:worker. Serverless hosts use the protected tick endpoint.
AUTOMATION_RUN_WORKER=
# Optional private token for a host-triggered POST /api/automation?action=tick.
AUTOMATION_WORKER_TOKEN=
# Microsoft 365 application access. Configure Mail.Read and tenant admin consent,
# restricted to the client's designated mailbox using Exchange application access controls.
# Mail.Send and mailbox mutations are not used by this reader.
MICROSOFT365_TENANT_ID=
MICROSOFT365_CLIENT_ID=
MICROSOFT365_CLIENT_SECRET=
MICROSOFT365_MAILBOX=
# Explicit approved ISO timestamp; prevents importing the entire mailbox history.
MICROSOFT365_INGEST_FROM=
# Separate service identities; choosing a demo persona grants no live access.
# Array of {email,kind:worker|client,nativeId,salt,passwordHash,name}.
# Generate a salted entry with npm run portal:account. Keep this server-side.
OCD_PORTAL_ACCOUNTS=
# Enable only after the client's arrival-sharing policy and devices are checked.
OCD_ARRIVAL_ENABLED=false
# Intake rules are server-owned JSON. Leave approval absent until OCD supplies its policy.
OCD_INTAKE_RULES={"version":"draft-v1","source":"Approval pending","requiredFields":["name","service","suburb","postcode"],"requiredDocuments":[],"mappings":{},"knowledge":[],"inboxSignals":{"tested":false,"gaps":[],"evidence":""}}
# Optional AI arrangement; never included in browser assets.
OCD_AI_API_KEY=
OCD_AI_MODEL=gpt-4.1-mini
# For a low-cost OpenRouter showcase, set provider=openrouter and model=mistralai/mistral-nemo.
OCD_AI_PROVIDER=openai
OPENROUTER_API_KEY=
# Allows AI text previews without claiming production extraction approval.
# Existing document import, review and ShiftCare handoff checks still apply.
OCD_AI_DEMO=false
# Optional multi-user accounts: JSON array of {email,password,role}.
# Roles: admin approves/verifies; coordinator prepares drafts; reader can read only.
WORKFLOW_STAFF_ACCOUNTS=
