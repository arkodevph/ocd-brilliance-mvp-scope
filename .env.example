# Copy these settings into your ignored .env.local.
# Public browser token only (pk.); never use a Mapbox secret token (sk.).
MAPBOX_PUBLIC_TOKEN=
# ShiftCare credentials stay on the server.
SHIFTCARE_API_REGION=au
SHIFTCARE_ACCOUNT_ID=
SHIFTCARE_API_KEY=
# Use the time zone configured in your ShiftCare account.
SHIFTCARE_TIME_ZONE=Australia/Sydney
