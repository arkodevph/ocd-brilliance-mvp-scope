{
  "name": "ocd-brilliance-mvp-scope",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run build:backend && npm run build:frontend && node server.cjs",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "tsc -p tsconfig.frontend.json && node scripts/build-frontend.cjs",
    "db:migrate": "npm run build:backend && node .backend/database/migrate.js",
    "build": "npm run build:backend && npm run build:frontend && node scripts/build-vercel.cjs",
    "pretest": "npm run build:backend && npm run build:frontend",
    "test": "node --test",
    "verify:prototype": "node scripts/prototype-browser-check.mjs",
    "verify:react": "PROTOTYPE_REACT=1 node scripts/prototype-browser-check.mjs",
    "verify:intake": "PROTOTYPE_INTAKE=1 node scripts/prototype-browser-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@tesseract.js-data/eng": "^1.0.0",
    "@upstash/redis": "^1.35.6",
    "html-react-parser": "^6.1.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0",
    "three": "0.186.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3"
  }
}
