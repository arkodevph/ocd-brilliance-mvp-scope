{
  "name": "ocd-brilliance-mvp-scope",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run build:backend && npm run build:frontend && node server.cjs",
    "build:backend": "node scripts/build-backend.cjs",
    "build:frontend": "tsc -p tsconfig.frontend.json && node scripts/build-frontend.cjs",
    "db:migrate": "npm run build:backend && node .backend/database/migrate.js",
    "build": "npm run build:backend && npm run build:frontend && node scripts/build-vercel.cjs",
    "pretest": "npm run build:backend && npm run build:frontend",
    "test": "node --test",
    "verify:prototype": "node scripts/prototype-browser-check.mjs",
    "verify:react": "PROTOTYPE_REACT=1 node scripts/prototype-browser-check.mjs",
    "verify:intake": "PROTOTYPE_INTAKE=1 node scripts/prototype-browser-check.mjs",
    "format": "prettier --write \"{api,backend,frontend,lib,scripts,tests,workspace}/**/*.{js,jsx,cjs,mjs,ts,tsx}\" server.cjs",
    "format:check": "prettier --check \"{api,backend,frontend,lib,scripts,tests,workspace}/**/*.{js,jsx,cjs,mjs,ts,tsx}\" server.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@solar-icons/js": "^2.3.1",
    "@solar-icons/react": "^2.3.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@upstash/redis": "^1.35.6",
    "hono": "^4.13.13",
    "html-react-parser": "^6.1.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0",
    "three": "0.186.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
