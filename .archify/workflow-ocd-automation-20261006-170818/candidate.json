    { "dot": "emerald", "title": "Intake, emails and agreements · A01–A03 / A10", "items": [
      "Accept website, email, phone and coordinator/provider referrals. Check service area before participant intake.",
      "Assign enquiry follow-up; link urgent invoice complaints to their invoice. Office ownership is a recommended design.",
      "Use existing agreement templates/signing and file returned documents against the correct participant.",
      "Evidence: CSV 358, 368, 814, 821, 855–857, 873 and 1168."
    ]},
    { "dot": "amber", "title": "Bookings and cover · A04–A06", "items": [
      "Keep recurring bookings, preferred hours and personal commitments. An empty slot requires worker confirmation.",
      "Use the agreed cancellation policy and escalate exceptions before changing the booking.",
      "Replacement offers and automatic reassignment need agreed rules; no available cover requires human follow-up.",
      "Evidence: CSV 540, 611, 614, 626, 631–640, 644, 662–663 and 973."
    ]},
    { "dot": "violet", "title": "Portals and Mapbox · P01–P03 / A12 / L01", "items": [
      "Office: bookings, enquiries and exceptions. Worker: assignments, confirmations and next-visit travel. Client: own bookings, requests, documents and ETA.",
      "Mapbox 3D for all three workspaces was requested later; employer uses the existing Worker workspace.",
      "ETA sharing needs agreed visit boundaries. Keep home addresses private and avoid duplicate ShiftCare worker entry.",
      "Evidence: CSV 520, 544, 565–574 and 651; later user instruction L01."
    ]},
    { "dot": "rose", "title": "Communication and access · A11", "items": [
      "Use one routine communication flow; retain admin-accessible message history.",
      "Protect personal phone numbers, confidential office notes and each person's records.",
      "Evidence: CSV 395–399, 478, 560, 581–588 and 593–607."
    ]},
    { "dot": "orange", "title": "Visit, documents and finance · A07–A09", "items": [
      "Office reviews major visit notes; the bookkeeper checks actual time, travel and agreed rates.",
      "Preserve the existing ShiftCare/Xero invoice export. Tuesday invoices and fortnightly payroll are separate routines.",
      "Fix false expiry flags as well as missing/expiring documents. Confirm travel rules; rounding fixes were lower priority.",
      "Evidence: CSV 93, 105, 446, 478, 486, 679, 693–702, 722, 726 and 1013."
    ]},
    { "dot": "slate", "title": "Decisions and later scope", "items": [
