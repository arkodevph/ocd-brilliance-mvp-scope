  "cards": [
    {
      "dot": "cyan",
      "title": "Actual client need",
      "items": [
        "Emailed/scanned onboarding currently needs entry into ShiftCare and Xero; reduce re-keying and missed ownership.",
        "Transcript: 351\u2013368, 814\u2013821, 855\u2013873, 1168. Employee onboarding bypasses the participant area gate."
      ]
    },
    {
      "dot": "emerald",
      "title": "Use native capability first",
      "items": [
        "Public referral submission waits for staff acceptance; acceptance creates a client. Do not create it again through OCD.",
        "Inbox Signals suggests document filing for staff review; unknown staff need manual review. Public referral forms cannot accept attachments.",
        "Check feature access before selecting either native route; otherwise use the reviewed UI/field-entry path."
      ]
    },
    {
      "dot": "amber",
      "title": "Supported mutation boundary",
      "items": [
        "Broader profile fields: Admin reviews UI/MCP change; create_client needs first name and DOB, create_staff needs name and email.",
        "MCP cannot upload a new document. Existing metadata correction is a separate approved action.",
        "REST automation stays disabled until API entitlement/key and the exact operation contract are tested."
      ]
    },
    {
      "dot": "rose",
      "title": "Verification and exceptions",
      "items": [
        "Missing DOB, consent, duplicate identity, wrong file type/person or unknown write outcome stays in manual review.",
        "Hold original evidence. Resolve in the office, then re-enter the selected review path; do not blindly repeat creation.",
        "Xero creation/linking and payroll onboarding are separate verified tasks; a ShiftCare ID does not prove they happened.",
        "The area-exception outcome can be negotiated/deferred/declined; it does not promise service capacity."
      ]
    },
    {
      "dot": "slate",
      "title": "Design and layout evidence",
      "items": [
        "Proposed process: docs/OCD_ShiftCare_Integration_and_Automation_Design.md, sections 3\u20139. Node tags identify responsibility/stage.",
        "This fixed-position Archify process chart preserves the steps and relationships of the lane-based specification; that draft is retained alongside its diagnostics.",
        "Rendering checks do not prove live integration. Native feature access, every future REST operation and the production account still require validation."
      ]
    }
  ]
