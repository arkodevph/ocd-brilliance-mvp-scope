  "cards": [
    {
      "dot": "cyan",
      "title": "Current workflow and trigger",
      "items": [
        "ShiftCare already sends the three-day SMS; replies reach admin email and shift event history. OCD prepares an owned response task.",
        "Office currently checks yes/no/cancellations daily. Transcript: 536\u2013540 and 644; late sickness 426; availability constraints 611\u2013626.",
        "Reply payload/thread matching and native feature settings still need validation in the real account."
      ]
    },
    {
      "dot": "rose",
      "title": "Cancellation is a financial decision",
      "items": [
        "Current with-charge MCP marks every client on the shift absent and retains billing; it accepts an NDIS reason code, not free text.",
        "Group cancellation, locked/invoiced records, client no-charge treatment or unclear policy go to native UI/office review.",
        "MCP requires specific confirmation. No unattended cancellation is approved here; any future REST operation has its own contract gate."
      ]
    },
    {
      "dot": "amber",
      "title": "Worker acceptance and coverage",
      "items": [
        "Re-use native Smart Match/Job Board; office checks qualifications, leave, hours, clashes and actual availability.",
        "Current MCP has no availability-schedule reader or Confirmation Required setter. notify:true is not worker acceptance.",
        "Set the native confirmation requirement; confirm the worker's actual response before telling a participant cover is booked.",
        "Preserve all assignments and distinguish a single occurrence from a reviewed series change."
      ]
    },
    {
      "dot": "emerald",
      "title": "Recovery and outcome",
      "items": [
        "Unclear reply: ask/resolve, then return to review. No reply is never a cancellation.",
        "Failed/uncertain write: read native state before retry; office/bookkeeper resolves and verifies the outcome.",
        "No cover: office contacts the participant about alternate time/service and records an explicit outcome.",
        "Use a validated native channel initially. App push and full chat-history synchronization are not established."
      ]
    },
    {
      "dot": "slate",
      "title": "Design and layout evidence",
      "items": [
        "Proposed process: docs/OCD_ShiftCare_Integration_and_Automation_Design.md, sections 3\u20139. Node tags identify responsibility/stage.",
        "This fixed-position Archify process chart preserves the steps and relationships of the lane-based specification; that draft is retained alongside its diagnostics.",
        "Rendering checks do not prove live integration. Native feature access, every future REST operation and the production account still require validation."
      ]
    }
  ]
